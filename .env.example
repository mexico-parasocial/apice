# Root environment for docker-compose.prod.yml.
# Copy to .env and fill in real values before deploying.

# PostgreSQL
POSTGRES_USER=apice
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=apice_prod

# Public URLs
NEXT_PUBLIC_API_URL=https://api.apice.example.com

# SeaweedFS
SEAWEED_DEFAULT_REPLICATION=000
SEAWEED_VOLUME_SIZE_LIMIT_MB=4096
SEAWEED_MAX_VOLUMES=100
SEAWEED_ACCESS_KEY=change-me-access-key
SEAWEED_SECRET_KEY=change-me-secret-key
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333
SEAWEED_FILER_POSTGRES_HOST=postgres
SEAWEED_FILER_POSTGRES_PORT=5432
SEAWEED_FILER_POSTGRES_USER=apice
SEAWEED_FILER_POSTGRES_DATABASE=apice_prod

# Streamplace self-hosted node
STREAMPLACE_PUBLIC_HOST=vod.apice.example.com
STREAMPLACE_VERSION=0.7.2
STREAMPLACE_PACKAGE_FILE_ID=786
STREAMPLACE_APP_BUNDLE_ID=com.apice.vod
STREAMPLACE_DB_URL=postgresql://apice:change-me-postgres@postgres:5432/apice_streamplace?sslmode=disable
STREAMPLACE_VOD_CONCURRENCY=2
STREAMPLACE_WIDE_OPEN=false
STREAMPLACE_ALLOWED_STREAMS=
SEAWEED_S3_REGION=us-east-1
