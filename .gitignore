# ── Secrets & environment ────────────────────────────────────────────────
# Real env files must never enter history. Examples stay public.
.env
.env.*
!.env.example
!.env.*.example

# ── Dependencies & builds ────────────────────────────────────────────────
node_modules/
apps/api/build/
apps/admin/.next/
apps/mobile/dist/
apps/mobile/web-build/
*.tsbuildinfo

# ── Expo / React Native ──────────────────────────────────────────────────
.expo/
ios/Pods/
ios/build/
android/build/
android/app/build/
*.orig.*

# ── Logs, caches, OS ─────────────────────────────────────────────────────
*.log
.DS_Store
npm-debug.*
yarn-error.log
coverage/

# ── Internal agent/session notes ─────────────────────────────
.zcode/

# Lesson clips live on disk and on the Streamplace node — never in git.
apps/api/fixtures/videos/*.mp4
!apps/api/fixtures/videos/TESTCLIP.MP4

# Course source material stays local — it lives on disk and gets cut into
# lesson clips; clips live on the Streamplace node. Git never carries video.
# Root-anchored: apps/mobile/assets and apps/admin/public/assets are code.
/assets/
