{
  "name": "apice-core",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:env": "./infra/scripts/dev/run-dev-env.sh",
    "dev:down": "docker compose down",
    "dev:api": "pnpm --filter @apice/api dev",
    "dev:admin": "pnpm --filter @apice/admin dev",
    "dev:indexer": "pnpm --filter @apice/api worker:indexer",
    "web": "pnpm --filter @apice/mobile web",
    "android": "pnpm --filter @apice/mobile android",
    "ios": "pnpm --filter @apice/mobile ios",
    "seed": "pnpm --filter @apice/api seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "doctor": "./infra/scripts/dev/doctor.sh",
    "prod:up": "docker compose -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:logs": "docker compose -f docker-compose.prod.yml logs -f",
    "prod:doctor": "./infra/scripts/dev/doctor.sh --prod",
    "prod:backup": "docker compose -f docker-compose.prod.yml exec backups /usr/local/bin/backup-postgres.sh"
  },
  "license": "GPL-3.0"
}
