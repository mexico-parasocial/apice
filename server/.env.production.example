# =============================================================================
# Ápice — producción (local + Cloudflare Tunnel)
# Dominio: apice.example.com
# Arquitectura: cloudflared enruta api./admin./vod. a los servicios internos;
# no se abren puertos en la máquina. Caddy queda solo como fallback
# (perfil "direct-origin").
# =============================================================================

PORT=8000
NODE_ENV=production

# ── Base de datos / cache ────────────────────────────────────────────────────
DATABASE_URL=postgresql://apice:change-me-postgres@postgres:5432/apice_prod?schema=public
REDIS_URL=redis://redis:6379

# ── URLs públicas (Cloudflare Tunnel) ────────────────────────────────────────
# CRÍTICO para el OAuth de Bluesky (client-metadata discoverable):
API_PUBLIC_URL=https://api.apice.example.com
ALLOWED_ORIGINS=https://admin.apice.example.com,https://api.apice.example.com
PUBLIC_COURSE_URL_TEMPLATE=https://api.apice.example.com/api/v1/network/courses

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN=change-me-long-random-string
REFRESH_TOKEN=change-me-other-long-random-string
ACCESS_TOKEN_EXPIRE=60
REFRESH_TOKEN_EXPIRE=10080
ACTIVATION_SECRET=change-me-activation-secret

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=change-me@example.com
SMTP_PASSWORD=change-me

# ── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# ── Stripe (inactivo este trimestre — todo gratis) ───────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_ENDPOINT_SECRET=whsec_...

# ── iM8 (legacy — el login principal es ATProto OAuth) ───────────────────────
IM8_IDENTITY_MANAGER_URL=https://im8.example.com

# ── ATProto / PDS ────────────────────────────────────────────────────────────
PDS_URL=https://bsky.social
PDS_SERVICE_HANDLE=apice.bsky.social
PDS_SERVICE_PASSWORD=change-me-app-password
PDS_PUBLISH_DID=did:plc:change-me
# OAuth propio: en prod NO usar loopback
ATPROTO_OAUTH_LOOPBACK=false

# ── Video (Streamplace node propio) ──────────────────────────────────────────
STREAMPLACE_VOD_BASE_URL=https://vod.apice.example.com
STREAMPLACE_PUBLIC_HOST=vod.apice.example.com
STREAMPLACE_PACKAGE_FILE_ID=786
# DIDs de instructores permitidos para subir (producción: NUNCA wide-open)
STREAMPLACE_WIDE_OPEN=false
STREAMPLACE_ALLOWED_STREAMS=did:plc:instructor-1,did:plc:instructor-2
STREAMPLACE_VOD_CONCURRENCY=2

# ── SeaweedFS S3 ─────────────────────────────────────────────────────────────
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333
SEAWEED_ACCESS_KEY=change-me-access-key
SEAWEED_SECRET_KEY=change-me-secret-key
SEAWEED_VIDEO_BUCKET=apice-videos
SEAWEED_ASSETS_BUCKET=apice-assets
SEAWEED_BACKUPS_BUCKET=apice-backups

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# cloudflared tunnel token apice
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token

# ── Indexer ──────────────────────────────────────────────────────────────────
JETSTREAM_URL=wss://jetstream1.us-east.bsky.network

# ── Sentry (pegar DSN del proyecto "apice") ──────────────────────────────────
SENTRY_DSN=

# ── Observabilidad ───────────────────────────────────────────────────────────
# /metrics expone contadores de Prometheus en el puerto público. Las etiquetas
# no contienen datos de usuarios (solo patrones de ruta y proveedores), pero
# si prefieres que no sea público tras el túnel: false.
METRICS_ENABLED=true
