# Server environment — copy to .env and fill in real values.
PORT=8000
DATABASE_URL=postgresql://apice:apice@localhost:5434/apice_dev?schema=public
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:8081

# JWT secrets — generate strong random strings
ACCESS_TOKEN=change-me-access-token
REFRESH_TOKEN=change-me-refresh-token
# Token lifetimes in MINUTES (access: 1h, refresh: 7d)
ACCESS_TOKEN_EXPIRE=60
REFRESH_TOKEN_EXPIRE=10080
ACTIVATION_SECRET=change-me-activation-secret

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SERVICE=gmail
SMTP_MAIL=change-me@example.com
SMTP_PASSWORD=change-me

# Cloudinary
CLOUDINARY_NAME=change-me
CLOUDINARY_API_KEY=change-me
CLOUDINARY_API_SECRET=change-me

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_ENDPOINT_SECRET=whsec_...

# iM8 identity manager
IM8_IDENTITY_MANAGER_URL=https://im8.example.com

# ATProto / Bluesky publisher (optional)
PDS_URL=https://bsky.social
PDS_SERVICE_HANDLE=change-me.bsky.social
PDS_SERVICE_PASSWORD=change-me
PDS_PUBLISH_DID=did:plc:change-me

# Video delivery
# Base URL for the Streamplace VOD node. Point this at your self-hosted node
# (e.g. https://vod.apice.example.com) for Option A, or keep stream.place for
# the managed service.
STREAMPLACE_VOD_BASE_URL=https://vod.apice.example.com

# SeaweedFS S3 gateway
SEAWEED_S3_ENDPOINT=http://seaweed-s3:8333
SEAWEED_ACCESS_KEY=change-me-access-key
SEAWEED_SECRET_KEY=change-me-secret-key
SEAWEED_VIDEO_BUCKET=apice-videos
SEAWEED_ASSETS_BUCKET=apice-assets
SEAWEED_BACKUPS_BUCKET=apice-backups

# Streamplace self-hosted node (used by docker-compose.prod.yml)
STREAMPLACE_PUBLIC_HOST=vod.apice.example.com
# Package file ID for the node binary: 786 = v0.11.13 linux-amd64
STREAMPLACE_PACKAGE_FILE_ID=786

# ── Headless video publish (scripts/publish-lesson-video.ts) ─────────────────
# Instructor app password — NOT the account password. Only needed to publish
# lesson videos from the CLI; the API itself never reads these.
# ATPROTO_HANDLE=instructor.bsky.social
# ATPROTO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ATPROTO_PDS_URL=https://bsky.social
# STREAMPLACE_PUBLISH_URL=http://localhost:38080
