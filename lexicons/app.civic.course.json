{
  "lexicon": 1,
  "id": "app.civic.course",
  "description": "A public civic education course published on the Atmosphere.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "title",
          "createdAt",
          "ownerDid"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "thumbnail": {
            "type": "blob",
            "accept": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "ownerDid": {
            "type": "string",
            "format": "did"
          },
          "tags": {
            "type": "array",
            "maxLength": 20,
            "items": {
              "type": "string",
              "maxLength": 50
            }
          },
          "sections": {
            "type": "array",
            "maxLength": 50,
            "items": {
              "type": "ref",
              "ref": "#section"
            }
          },
          "videoManifestRef": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "lessons": {
          "type": "array",
          "maxLength": 100,
          "items": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef"
          }
        }
      }
    }
  }
}